# Copy to .env and fill in new values.
# Steam Game Server Login Token, exactly 32 hexadecimal characters.
SRCDS_TOKEN=
# At least 16 characters, A-Z, a-z and 0-9 only.
CS2_RCONPW=
# At least 8 characters, A-Z, a-z and 0-9 only.
CS2_PW=
CS2_SERVERNAME=Repserver
# Fallback when there is no saved map in data/state/last-map.
CS2_STARTMAP=de_inferno
CS2_PUBLIC_PORT=27015
# CS2_BASE_IMAGE=joedwards32/cs2@sha256:...
